<Application x:Class="ITMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ITMonitor"
             StartupUri="View/LoginView.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="AppBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AppBorder" Color="#333333"/>
        <SolidColorBrush x:Key="AppText" Color="#BBBBBB"/>
        <SolidColorBrush x:Key="InputBackground" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="LeftPanelBackground" Color="#161617"/>
        <SolidColorBrush x:Key="LogoColor" Color="#2D2D2D"/>

    </Application.Resources>
</Application>