<UserControl x:Class="ITMonitor.View.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Modern Buton Şablonu -->
        <Style TargetType="Button" x:Key="FlatRoundedButton">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tablo Başlıkları -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{DynamicResource AppBackground}" 
                                BorderBrush="{DynamicResource AppBorder}" 
                                BorderThickness="0,0,0,1" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tablo Öğeleri -->
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <!-- GÜNCELLENEN KISIM: Dış ScrollViewer kaldırıldı. Ana Grid, taşma koruması olan margin (40) ile pencereye tam oturtuldu. -->
    <Grid Margin="20,20,20,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık Satırı -->
            <RowDefinition Height="*"/>
            <!-- Liste Satırı (Kendi içinde kaydırılabilir alan) -->
            <RowDefinition Height="Auto"/>
            <!-- Sabit Buton Satırı -->
        </Grid.RowDefinitions>

        <!-- BAŞLIK VE ARAMA KUTUSU -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="📄 Raporlama ve Çıktı Merkezi" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                <TextBlock Text="Ağ durumunu, bağlantısı kopan cihazları görüntüleyin ve anında dışa aktarın." 
                           Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="10,5" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="🔍 Raporda Ara..." Foreground="{DynamicResource AppText}" Opacity="0.4" VerticalAlignment="Center" Margin="5,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" Background="Transparent" Foreground="{DynamicResource AppText}" BorderThickness="0" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- RAPOR ÖNİZLEME LİSTESİ -->
        <!-- Grid.Row="1" ve Height="*" sayesinde bu alan kalan boşluğu kaplar ve liste uzadıkça kendi ScrollViewer'ını çalıştırır -->
        <Border Grid.Row="1" Background="{DynamicResource InputBackground}" CornerRadius="12" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Rapor Önizlemesi (Hatalı / Pasif Cihazlar)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Margin="0,0,0,15"/>

                <ListView x:Name="ReportPreviewList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppText}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Durum" Width="80" DisplayMemberBinding="{Binding StatusIcon}"/>
                            <GridViewColumn Header="Cihaz Adı" Width="200" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="IP / URL" Width="180" DisplayMemberBinding="{Binding IpOrUrl}"/>
                            <GridViewColumn Header="Hata Detayı" Width="250" DisplayMemberBinding="{Binding LastErrorMessage}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- AKSİYON BUTONLARI -->
        <!-- Bu kısım daima en altta sabit kalacaktır -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

            <Button x:Name="BtnExportTxt" Content="📝 TXT Kaydet" Click="BtnExportTxt_Click" 
                    Width="110" Height="40" Margin="0,0,10,0"
                    Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                    Style="{StaticResource FlatRoundedButton}" />

            <Button x:Name="BtnExportPdf" Content="📄 Hatalıları Kaydet" Click="BtnExportPdf_Click" 
                    Width="140" Height="40" Margin="0,0,10,0"
                    Background="#E74C3C" Foreground="White"
                    Style="{StaticResource FlatRoundedButton}" />

            <Button x:Name="BtnExportDetailedPdf" Content="📊 Tümünü Raporla (Detaylı)" Click="BtnExportDetailedPdf_Click" 
                    Width="190" Height="40" Margin="0,0,10,0"
                    Background="#8E44AD" Foreground="White"
                    Style="{StaticResource FlatRoundedButton}" />

            <Button x:Name="BtnPrint" Content="🖨️ Yazdır" Click="BtnPrint_Click" 
                    Width="90" Height="40" Margin="0,0,10,0"
                    Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                    Style="{StaticResource FlatRoundedButton}" />

            <Button x:Name="BtnSendEmail" Content="📧 E-Posta Gönder" Click="BtnSendEmail_Click" 
                    Width="130" Height="40"
                    Background="#3498DB" Foreground="White"
                    Style="{StaticResource FlatRoundedButton}" />

        </StackPanel>
    </Grid>
</UserControl>