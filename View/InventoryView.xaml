<UserControl x:Class="ITMonitor.View.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1050"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6">
                <Border x:Name="splitBorder" HorizontalAlignment="Right" Width="30">
                    <Path x:Name="arrow" 
                          Data="M 0 0 L 4 4 L 8 0 Z" 
                          Fill="{DynamicResource AppText}" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Opacity="0.6"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#007AFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="mainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Template="{StaticResource ComboBoxToggleButton}"/>

                            <!-- Yazı Yazılabilir (IsEditable=True) Mod için TextBox Desteği -->
                            <TextBox x:Name="PART_EditableTextBox" 
                                     Style="{x:Null}" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center" 
                                     Margin="10,0" 
                                     Background="Transparent" 
                                     Foreground="{DynamicResource AppText}" 
                                     BorderThickness="0" 
                                     Visibility="Hidden"/>

                            <ContentPresenter x:Name="contentTemplate" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Margin="{TemplateBinding Padding}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   PopupAnimation="Slide" 
                                   Placement="Bottom">
                                <Border x:Name="dropDownBorder" 
                                        Background="{DynamicResource InputBackground}" 
                                        BorderBrush="{DynamicResource AppBorder}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Margin="0,4,0,0" 
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, ElementName=mainGrid}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="contentTemplate" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{DynamicResource AppBackground}" 
                                BorderBrush="{DynamicResource AppBorder}" 
                                BorderThickness="0,0,0,1" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource InputBackground}" CornerRadius="12" Margin="5,5,15,5" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📂 Envanter Listesi" Foreground="{DynamicResource AppText}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                        <StackPanel.Resources>
                            <Style TargetType="Button" x:Key="RoundedButton">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <Button Content="📥 İçe Aktar" Width="90" Height="30" Margin="0,0,10,0" Click="BtnImport_Click" Background="#2E8B57" Style="{StaticResource RoundedButton}"/>
                        <Button Content="📤 Dışa Aktar" Width="90" Height="30" Click="BtnExport_Click" Background="#4682B4" Style="{StaticResource RoundedButton}"/>
                    </StackPanel>

                    <Border Grid.Column="3" Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="10,5" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="🔍 Ara..." Foreground="{DynamicResource AppText}" Opacity="0.4" VerticalAlignment="Center" Margin="5,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" Background="Transparent" Foreground="{DynamicResource AppText}" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <ListView Grid.Row="1" x:Name="DeviceListView" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppText}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Durum" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#E74C3C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Fill" Value="#2ECC71"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LastScanTime}" Value="{x:Null}">
                                                            <Setter Property="Fill" Value="#F1C40F"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Cihaz Adı" Width="130" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="IP / URL" Width="120" DisplayMemberBinding="{Binding IpOrUrl}"/>
                            <GridViewColumn Header="Kategori" Width="100" DisplayMemberBinding="{Binding Category}"/>
                            <GridViewColumn Header="Yöntem" Width="60" DisplayMemberBinding="{Binding Method}"/>
                            <GridViewColumn Header="Görev/Açıklama" Width="150" DisplayMemberBinding="{Binding Description}"/>
                            <GridViewColumn Header="İşlemler" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="BtnEdit_Click" Tag="{Binding Id}" Margin="0,0,6,0" Padding="8,4" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✏️ " FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Düzenle" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Click="BtnDelete_Click" Tag="{Binding Id}" Padding="8,4" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️ " FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Sil" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource InputBackground}" CornerRadius="12" Margin="5" Padding="20">
            <StackPanel>
                <TextBlock x:Name="FormTitleText" Text="Cihaz Detayları" Foreground="{DynamicResource AppText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,25"/>

                <TextBlock Text="Cihaz Adı" Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="12" FontWeight="Medium" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource AppBackground}" CornerRadius="6" Height="35" Margin="0,0,0,15" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                    <TextBox x:Name="TxtDeviceName" Background="Transparent" Foreground="{DynamicResource AppText}" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="IP Adresi veya URL" Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="12" FontWeight="Medium" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource AppBackground}" CornerRadius="6" Height="35" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Margin="0,0,8,0">
                        <TextBox x:Name="TxtIpOrUrl" Background="Transparent" Foreground="{DynamicResource AppText}" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="BtnAutoDiscover" Click="BtnAutoDiscover_Click" Content="🔍 Otomatik Tanı" Height="35" Padding="12,0" Background="#FF9500" Foreground="White" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#FFB347"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Text="Kategori" Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="12" FontWeight="Medium" Margin="0,0,0,5"/>
                <!-- IsEditable="True" YAPARAK ÖZEL KATEGORİ YAZMAYA İZİN VERİYORUZ -->
                <ComboBox x:Name="CmbCategory" Margin="0,0,0,15" IsEditable="True" ToolTip="Listeden seçebilir veya yeni bir kategori yazabilirsiniz"/>

                <TextBlock Text="İzleme Yöntemi" Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="12" FontWeight="Medium" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbMethod" Margin="0,0,0,15">
                    <ComboBoxItem Content="Ping (ICMP)" IsSelected="True"/>
                    <ComboBoxItem Content="HTTP / HTTPS (Web)"/>
                    <ComboBoxItem Content="TCP - SQL Server (1433)"/>
                    <ComboBoxItem Content="TCP - PostgreSQL (5432)"/>
                    <ComboBoxItem Content="TCP - MySQL (3306)"/>
                    <ComboBoxItem Content="TCP - Uzak Masaüstü (3389)"/>
                    <ComboBoxItem Content="TCP - SSH (22)"/>
                    <ComboBoxItem Content="TCP - Yazıcı (9100)"/>
                    <ComboBoxItem Content="TCP - Özel Port"/>
                    <ComboBoxItem Content="SNMP (v1/v2c)"/>
                </ComboBox>

                <TextBlock Text="Görev / Açıklama" Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="12" FontWeight="Medium" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource AppBackground}" CornerRadius="6" Height="35" Margin="0,0,0,25" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                    <TextBox x:Name="TxtDescription" Background="Transparent" Foreground="{DynamicResource AppText}" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" ToolTip="Örn: Muhasebe departmanı yazıcısı"/>
                </Border>

                <Button x:Name="BtnSave" Click="BtnSave_Click" Content="Kaydet" Height="40" Background="#007AFF" Foreground="White" FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#147CE5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="BtnCancel" Click="BtnCancel_Click" Content="İptal / Temizle" Height="40" Background="Transparent" Foreground="{DynamicResource AppText}" Opacity="0.7" FontWeight="SemiBold" FontSize="13" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#1A000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>