<Window x:Class="ITMonitor.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ITMonitor.View"
        mc:Ignorable="d"
        Title="LoginView" Height="550" Width="800"
        WindowStyle="None" 
        Icon="/Images/icon.ico"
        RenderOptions.BitmapScalingMode="HighQuality" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown" >

    <Border x:Name="MainWindowBorder"
            CornerRadius="12"
            Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="LeftPanelBorder" CornerRadius="11,0,0,11" Background="{DynamicResource LeftPanelBackground}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <Border Width="70" 
                            Height="70" 
                            x:Name="LogoContainer"
                            CornerRadius="17" 
                            HorizontalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="/Images/icon.ico" 
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Stretch="Uniform"/>
                        </Border.Background>
                    </Border>

                    <TextBlock x:Name="LeftTitle" Text="ITMonitor" Foreground="{DynamicResource AppText}" FontSize="22" FontWeight="Bold" Margin="0,15,0,5" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="LeftSubtitle" Text="Sistem İzleme Paneli" Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="12" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top"
                            Panel.ZIndex="10">

                    <Button x:Name="ThemeButton" Width="46" Height="32" 
                            Click="ThemeButton_Click" 
                            Cursor="Hand"
                            Background="Transparent" 
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                                <TextBlock x:Name="themeIcon" 
                                                           Text="🌙" 
                                                           Foreground="{DynamicResource AppText}"
                                                           FontSize="12" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#2D2D2D"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Light"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#E5E5E5"/>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="MinimizeButton" Width="46" Height="32" 
                            Click="MinimizeButton_Click" 
                            Cursor="Hand"
                            Background="Transparent" 
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                                <TextBlock x:Name="minIcon"
                                                           Text="─" 
                                                           Foreground="{DynamicResource AppText}" 
                                                           FontSize="10" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#2D2D2D"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Light"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#E5E5E5"/>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="CloseButton" Width="46" Height="32" 
                            Click="CloseButton_Click" 
                            Cursor="Hand"
                            Background="Transparent" 
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="0,11,0,0">
                                                <TextBlock x:Name="closeIcon"
                                                           Text="✕" 
                                                           Foreground="{DynamicResource AppText}" 
                                                           FontSize="10" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid Margin="40,50,40,40">
                    <StackPanel VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Center">
                        <TextBlock x:Name="FormTitle" Text="Oturum Açın" Foreground="{DynamicResource AppText}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="FormSubtitle" Text="Devam etmek için bilgilerinizi girin." Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="12" Margin="0,0,0,25" FontFamily="Segoe UI"/>

                        <TextBlock x:Name="UserLabel" Text="Kullanıcı Adı" Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="11" FontWeight="Medium" Margin="0,0,0,6"/>
                        <Border x:Name="UserBorder" Background="{DynamicResource InputBackground}" CornerRadius="6" Height="38" Margin="0,0,0,15">
                            <TextBox x:Name="UserTextBox" 
                                     Background="Transparent" 
                                     Foreground="{DynamicResource AppText}" 
                                     BorderThickness="0" 
                                     Padding="12,0" 
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="PassLabel" Text="Şifre" Foreground="{DynamicResource AppText}" Opacity="0.7" FontSize="11" FontWeight="Medium" Margin="0,0,0,6"/>
                        <Border x:Name="PassBorder" Background="{DynamicResource InputBackground}" CornerRadius="6" Height="38" Margin="0,0,0,25">
                            <PasswordBox x:Name="PassPasswordBox" 
                                         Background="Transparent" 
                                         Foreground="{DynamicResource AppText}" 
                                         BorderThickness="0" 
                                         Padding="12,0" 
                                         VerticalContentAlignment="Center"/>
                        </Border>

                        <Button x:Name="BtnLogin" Click="LoginButton_Click" IsDefault="True" Height="40" 
        Background="#3585A6" Foreground="White" FontWeight="SemiBold" 
        BorderThickness="0" Cursor="Hand" Margin="0,10,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>

                            <Grid>
                                <TextBlock x:Name="BtnText" Text="Giriş Yap" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <Ellipse x:Name="LoadingSpinner" Width="20" Height="20" 
                 Stroke="#3585A6" 
                 StrokeThickness="2.5" 
                 StrokeDashArray="20, 8" 
                 RenderTransformOrigin="0.5,0.5" 
                 Visibility="Collapsed" 
                 HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                                    </Ellipse.RenderTransform>

                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation" 
                                             Storyboard.TargetProperty="Angle" 
                                             From="0" To="360" Duration="0:0:1.5" 
                                             RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                        </Button>

                        <TextBlock x:Name="ForgotText" Text="Şifremi Unuttum" Foreground="#3585A6" FontSize="12" HorizontalAlignment="Center" Margin="0,15,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>