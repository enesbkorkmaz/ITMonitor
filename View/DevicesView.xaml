<UserControl x:Class="ITMonitor.View.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="🖥️ Cihazlar" Foreground="{DynamicResource AppText}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>

            <Border Grid.Column="1" Background="{DynamicResource InputBackground}" CornerRadius="8" Padding="10,5">
                <Grid>
                    <TextBlock Text="Cihaz ara..." Foreground="{DynamicResource AppText}" Opacity="0.4" VerticalAlignment="Center" Margin="5,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" Background="Transparent" Foreground="{DynamicResource AppText}" BorderThickness="0" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="5,0,15,0">
            <ItemsControl x:Name="CategoryItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,25">

                            <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="15,8" Margin="0,0,0,15" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource AppText}" FontSize="15" FontWeight="Bold"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="160" Height="190" Background="{DynamicResource InputBackground}" CornerRadius="12" Margin="0,0,15,15" Padding="15,10">
                                            <Grid>
                                                <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#E74C3C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="#2ECC71"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <TextBlock FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🖥️"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Category}" Value="Web Servisi">
                                                                    <Setter Property="Text" Value="🌍"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="Ofis Cihazı">
                                                                    <Setter Property="Text" Value="💻"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="Ağ Cihazı (Switch/Router)">
                                                                    <Setter Property="Text" Value="📡"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="Güvenlik Duvarı (Firewall)">
                                                                    <Setter Property="Text" Value="🛡️"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="Yazıcı">
                                                                    <Setter Property="Text" Value="🖨️"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="Veritabanı Sunucusu">
                                                                    <Setter Property="Text" Value="🗄️"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="Diğer">
                                                                    <Setter Property="Text" Value="⚙️"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppText}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding IpOrUrl}" Foreground="{DynamicResource AppText}" Opacity="0.6" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
<TextBlock Text="{Binding Description}" Foreground="{DynamicResource AppText}" Opacity="0.5" FontSize="10" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                                    <TextBlock Foreground="{DynamicResource AppText}" Opacity="0.5" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                        <Run Text="Son Tarama: "/>
                                                        <Run Text="{Binding LastScanTime, StringFormat='dd.MM.yyyy HH:mm', TargetNullValue='Henüz taranmadı'}"/>
                                                    </TextBlock>

                                                    <Button Content="🔄 Yeniden Tara" Click="Rescan_Click" Tag="{Binding Id}" Background="Transparent" Foreground="#007AFF" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,4,0,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>