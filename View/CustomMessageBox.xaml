<Window x:Class="ITMonitor.View.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="380" Height="210"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Border Background="{DynamicResource InputBackground}" 
            BorderBrush="{DynamicResource AppBorder}" 
            BorderThickness="1" 
            CornerRadius="12" 
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="TxtTitle" Text="Bildirim" Foreground="{DynamicResource AppText}" FontSize="16" FontWeight="Bold"/>
                <Button Content="✕" Click="BtnClose_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource AppText}" Opacity="0.6" BorderThickness="0" Cursor="Hand" FontSize="14"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtIcon" Grid.Column="0" Text="ℹ️" FontSize="36" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <TextBlock x:Name="TxtMessage" Grid.Column="1" Text="İşlem mesajı buraya gelecek." Foreground="{DynamicResource AppText}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnOk" Click="BtnOk_Click" Content="Tamam" Width="90" Height="34" Background="#007AFF" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnYes" Click="BtnYes_Click" Content="Evet" Width="90" Height="34" Background="#2ECC71" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Margin="5,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnNo" Click="BtnNo_Click" Content="Hayır" Width="90" Height="34" Background="Transparent" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Cursor="Hand" Visibility="Collapsed" Margin="5,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>