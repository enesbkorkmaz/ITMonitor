<Window x:Class="ITMonitor.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITMonitor - Kontrol Paneli" 
        Height="700" Width="1200" 
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/icon.ico"
        WindowStyle="None"
        AllowsTransparency="True" 
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" 
            CornerRadius="12" 
            Background="{DynamicResource AppBackground}" 
            BorderBrush="{DynamicResource AppBorder}" 
            BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL -->
            <Border x:Name="LeftPanelBorder" Grid.Column="0" CornerRadius="11,0,0,11" Background="{DynamicResource LeftPanelBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Width="45" Height="45" CornerRadius="11" Background="{DynamicResource LogoColor}">
                            <Image Source="/Images/icon.ico" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Margin="5"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ITMonitor" Foreground="{DynamicResource AppText}" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock Text="Kontrol Paneli" Foreground="{DynamicResource AppText}" Opacity="0.6" FontSize="11" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="10,20,10,0">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton" x:Key="MenuButtonStyle">
                                <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
                                <Setter Property="Height" Value="45"/>
                                <Setter Property="Margin" Value="0,5"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="MenuBorder" CornerRadius="8" Background="Transparent" Padding="15,0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MenuBorder" Property="Background" Value="{DynamicResource InputBackground}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="MenuBorder" Property="Background" Value="#147CE5"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <RadioButton x:Name="BtnDashboard" Content="📊 Dashboard" Style="{StaticResource MenuButtonStyle}" Checked="MenuButton_Checked"/>
                        <RadioButton x:Name="BtnDevices" Content="🖥️ Cihazlar" Style="{StaticResource MenuButtonStyle}" Checked="MenuButton_Checked"/>
                        <RadioButton x:Name="BtnInventory" Content="📂 Envanter Yönetimi" Style="{StaticResource MenuButtonStyle}" Checked="MenuButton_Checked"/>
                        <RadioButton x:Name="BtnReports" Style="{StaticResource MenuButtonStyle}" Content="📄 Raporlar" Checked="MenuButton_Checked"/>
                        <RadioButton x:Name="BtnSettings" Content="⚙️ Ayarlar" Style="{StaticResource MenuButtonStyle}" Checked="MenuButton_Checked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SAĞ PANEL -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ÜST BAR (Top Bar) -->
                <Grid Grid.Row="0" Background="Transparent">
                    <Border Background="Transparent" MouseDown="TopBar_MouseDown"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" WindowChrome.IsHitTestVisibleInChrome="True">

                        <!-- YENİ DİNAMİK KULLANICI ALANI VE ÇIKIŞ BUTONU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="👤 Hoş geldin, " Foreground="{DynamicResource AppText}" Opacity="0.8" VerticalAlignment="Center" FontSize="13" Margin="0,0,3,0"/>
                            <TextBlock x:Name="TxtUsername" Text="Admin" Foreground="{DynamicResource AppText}" FontWeight="Bold" VerticalAlignment="Center" FontSize="13" Margin="0,0,15,0"/>

                            <Button x:Name="BtnLogout" Click="BtnLogout_Click" Content="🚪 Çıkış Yap" Background="#E74C3C" Foreground="White" Padding="12,5" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- PENCERE KONTROL BUTONLARI -->
                        <Button x:Name="ThemeButton" Width="40" Height="30" Click="ThemeButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" CornerRadius="6" Background="Transparent">
                                                    <TextBlock x:Name="themeIcon" Text="🌙" Foreground="{DynamicResource AppText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource InputBackground}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Width="40" Height="30" Click="MinimizeButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" CornerRadius="6" Background="Transparent">
                                                    <TextBlock Text="─" Foreground="{DynamicResource AppText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource InputBackground}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Width="40" Height="30" Click="MaximizeButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" CornerRadius="6" Background="Transparent">
                                                    <TextBlock Text="⬜" Foreground="{DynamicResource AppText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource InputBackground}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Width="40" Height="30" Click="CloseButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" CornerRadius="6" Background="Transparent">
                                                    <TextBlock Text="✕" Foreground="{DynamicResource AppText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>
                </Grid>

                <!-- ANA İÇERİK ALANI -->
                <ContentControl Grid.Row="1" x:Name="MainContentArea" Margin="20"/>

            </Grid>
        </Grid>
    </Border>
</Window>